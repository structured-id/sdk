{
  "name": "@structured-id/ids",
  "version": "0.1.0",
  "type": "module",
  "description": "StructuredID identifiers: one checked type per identifier kind, the sid.v1.ids wire messages and validated conversions between them.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schema/sid/v1/ids/ids.proto": "./schema/sid/v1/ids/ids.proto"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "schema": "node scripts/schema.mjs",
    "generate": "node scripts/schema.mjs && buf generate schema",
    "build": "yarn generate && tsup",
    "test": "yarn generate && vitest run",
    "lint": "yarn generate && eslint src/ tests/",
    "typecheck": "yarn generate && tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "prepack": "yarn build"
  },
  "keywords": [
    "structuredid",
    "identifier",
    "uuidv7",
    "protobuf"
  ],
  "author": "StructuredID <oss@structured.id>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/structured-id/sdk.git",
    "directory": "typescript/packages/ids"
  },
  "bugs": {
    "url": "https://github.com/structured-id/sdk/issues"
  },
  "homepage": "https://github.com/structured-id/sdk/tree/main/typescript/packages/ids#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@protobuf-ts/runtime": "^2.11.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@eslint/js": "^10.0.1",
    "@protobuf-ts/plugin": "^2.11.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
